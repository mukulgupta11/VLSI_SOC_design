library (asap7sc7p5t_SLVT_SS_ccs) {
  technology (cmos);
  delay_model : table_lookup;
  time_unit : "1ps";
  voltage_unit : "1V";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  capacitive_load_unit (1, pf);

  nom_process : 1.0;
  nom_temperature : 125.0;
  nom_voltage : 0.65;

  operating_conditions (SS_0P65V_125C) {
    process : 1.0;
    temperature : 125.0;
    voltage : 0.65;
  }
  default_operating_conditions : SS_0P65V_125C;

  lu_table_template (ccs_delay_template) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("10.0, 30.0, 60.0");
    index_2 ("0.002, 0.020, 0.100");
  }

  cell (INV_X1) {
    area : 0.0576;
    pin (A) {
      direction : input;
      capacitance : 0.0016;
    }
    pin (Y) {
      direction : output;
      capacitance : 0.0008;
      function : "!A";
      timing () {
        related_pin : "A";
        timing_sense : negative_unate;
        cell_rise (ccs_delay_template) {
          values ("18.5, 28.6, 52.1", \
                  "21.5, 32.8, 59.8", \
                  "27.8, 41.5, 74.2");
        }
        cell_fall (ccs_delay_template) {
          values ("17.6, 27.2, 49.5", \
                  "20.2, 31.1, 56.5", \
                  "26.1, 39.2, 70.4");
        }
      }
    }
  }

  cell (NAND2_X1) {
    area : 0.1152;
    pin (A) {
      direction : input;
      capacitance : 0.0018;
    }
    pin (B) {
      direction : input;
      capacitance : 0.0017;
    }
    pin (Y) {
      direction : output;
      function : "!(A & B)";
      timing () {
        related_pin : "A";
        timing_sense : negative_unate;
        cell_rise (ccs_delay_template) {
          values ("23.5, 35.8, 64.2", \
                  "27.2, 41.0, 72.8", \
                  "35.0, 51.5, 90.2");
        }
        cell_fall (ccs_delay_template) {
          values ("22.1, 33.5, 59.8", \
                  "25.4, 38.2, 67.5", \
                  "32.5, 47.9, 83.8");
        }
      }
    }
  }

  cell (NOR2_X1) {
    area : 0.1152;
    pin (A) {
      direction : input;
      capacitance : 0.0019;
    }
    pin (B) {
      direction : input;
      capacitance : 0.0018;
    }
    pin (Y) {
      direction : output;
      function : "!(A | B)";
      timing () {
        related_pin : "A";
        timing_sense : negative_unate;
        cell_rise (ccs_delay_template) {
          values ("25.2, 38.5, 69.5", \
                  "29.1, 44.0, 78.5", \
                  "37.5, 55.2, 97.4");
        }
        cell_fall (ccs_delay_template) {
          values ("23.8, 35.8, 64.5", \
                  "27.4, 41.2, 73.1", \
                  "35.1, 51.8, 90.5");
        }
      }
    }
  }

  cell (BUF_X4) {
    area : 0.1728;
    pin (A) {
      direction : input;
      capacitance : 0.0022;
    }
    pin (Y) {
      direction : output;
      function : "A";
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise (ccs_delay_template) {
          values ("26.5, 38.2, 62.5", \
                  "30.5, 43.8, 71.0", \
                  "38.5, 54.6, 87.2");
        }
        cell_fall (ccs_delay_template) {
          values ("25.2, 36.5, 60.1", \
                  "29.0, 41.9, 68.2", \
                  "36.8, 52.1, 83.9");
        }
      }
    }
  }

  cell (DFF_X1) {
    area : 0.2304;
    ff (IQ, IQN) {
      next_state : "D";
      clocked_on : "CLK";
    }
    pin (CLK) {
      direction : input;
      capacitance : 0.0028;
    }
    pin (D) {
      direction : input;
      capacitance : 0.0019;
      timing () {
        related_pin : "CLK";
        timing_type : setup_rising;
        rise_constraint (ccs_delay_template) {
          values ("35.0, 35.0, 35.0", "35.0, 35.0, 35.0", "35.0, 35.0, 35.0");
        }
      }
      timing () {
        related_pin : "CLK";
        timing_type : hold_rising;
        rise_constraint (ccs_delay_template) {
          values ("10.0, 10.0, 10.0", "10.0, 10.0, 10.0", "10.0, 10.0, 10.0");
        }
      }
    }
    pin (Q) {
      direction : output;
      function : "IQ";
      timing () {
        related_pin : "CLK";
        timing_type : rising_edge;
        cell_rise (ccs_delay_template) {
          values ("55.0, 72.5, 110.0", \
                  "62.5, 81.8, 124.2", \
                  "78.2, 101.1, 150.8");
        }
        cell_fall (ccs_delay_template) {
          values ("53.2, 70.4, 106.5", \
                  "60.6, 79.5, 120.6", \
                  "75.1, 98.8, 146.9");
        }
      }
    }
  }

  cell (LS_HL) {
    area : 0.2304;
    level_shifter_type : "HL";
    pin (A) {
      direction : input;
      capacitance : 0.0024;
    }
    pin (Y) {
      direction : output;
      function : "A";
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise (ccs_delay_template) {
          values ("42.5, 58.2, 89.5", \
                  "48.2, 65.8, 99.5", \
                  "60.5, 81.6, 122.2");
        }
        cell_fall (ccs_delay_template) {
          values ("40.8, 56.4, 86.2", \
                  "46.4, 63.8, 96.1", \
                  "58.5, 78.4, 118.6");
        }
      }
    }
  }

  cell (ISO_AND) {
    area : 0.1728;
    pin (A) {
      direction : input;
      capacitance : 0.0020;
    }
    pin (EN) {
      direction : input;
      capacitance : 0.0022;
    }
    pin (Y) {
      direction : output;
      function : "A & EN";
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise (ccs_delay_template) {
          values ("32.2, 45.5, 71.2", \
                  "36.8, 51.4, 80.5", \
                  "46.4, 64.2, 98.6");
        }
        cell_fall (ccs_delay_template) {
          values ("30.5, 43.6, 68.0", \
                  "35.1, 49.3, 76.8", \
                  "44.5, 61.5, 94.8");
        }
      }
    }
  }
}
