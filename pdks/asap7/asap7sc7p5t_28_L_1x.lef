VERSION 5.8 ;
BUSBITCHARS "[]" ;
DIVIDERCHAR "/" ;

MACRO INV_X1
  CLASS CORE ;
  ORIGIN 0 0 ;
  SIZE 0.240 BY 0.240 ;
  SYMMETRY X Y ;
  SITE asap7sc7p5t ;
  PIN A
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER metal1 ;
        RECT 0.020 0.060 0.060 0.180 ;
    END
  END A
  PIN Y
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER metal1 ;
        RECT 0.180 0.060 0.220 0.180 ;
    END
  END Y
  OBS
    LAYER metal1 ;
      RECT 0.000 0.000 0.240 0.020 ;
      RECT 0.000 0.220 0.240 0.240 ;
  END
END INV_X1

