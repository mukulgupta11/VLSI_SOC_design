      LAYER metal1 ;
        RECT 0.020 0.060 0.060 0.180 ;
    END
  END CLK
  PIN D
    DIRECTION INPUT ;
    USE SIGNAL ;
    PORT
      LAYER metal1 ;
        RECT 0.100 0.060 0.140 0.180 ;
